properties([
    parameters([
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Docker image tag (defaults to git commit SHA if left empty)')
    ])
])

// Load and run the pipeline logic from the library script
def pipelineLib
node {
    checkout scm
    // Default IMAGE_TAG to short commit SHA if not provided
    if (!params.IMAGE_TAG?.trim()) {
        env.IMAGE_TAG_OVERRIDE = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
    }
    pipelineLib = load 'apps/jenkins/lib/pipeline.groovy'
}
pipelineLib()
